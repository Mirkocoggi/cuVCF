@startuml
title Data structures and where they live

skinparam component {
    BackgroundColor<<Host>> #D6EAF8
    BackgroundColor<<Device>> #FADBD8
    BackgroundColor<<Persistent>> #FCF3CF
    BorderColor #2C3E50
}

package "Host (RAM)" {
    component "DataFrames\ndf1, df2, df3, df4" <<Host>> as DF
    note bottom: input read-only,\n"natural" layout

    component "HostBuffers\nhost_buffers" <<Host>> as HB
    note bottom: staging buffers,\nrebuilt per chunk

    component "h_compacted" <<Host>> as HC
    note bottom: receives compacted\noutput per chunk
}

package "Device (GPU)" {
    package "Per-chunk (alloc/free)" {
        component "d_df1\nd_df2\nd_df3.sample_*\nd_output\nd_line_lens\nd_compacted\nd_output_offsets" <<Device>> as DC
    }

    package "Per-dataset (allocated once)" {
        component "d_maps\n(chrom, filter, tsa,\npolyphen, csq)" <<Persistent>> as DM
        component "d_df1.*_names\nd_df2.alt_*_names\nd_df3.format_str" <<Persistent>> as DN
    }
}

DF -down-> HB : prepareHostBuffers()\n(transpose + pack)
HB -right-> DC : uploadToDevice()\n(cudaMemcpy H2D)
DM -[hidden]down- DC
DN -[hidden]down- DC
DC -down-> HC : compactKernel\n+ cudaMemcpy D2H\n(only live bytes)

@enduml